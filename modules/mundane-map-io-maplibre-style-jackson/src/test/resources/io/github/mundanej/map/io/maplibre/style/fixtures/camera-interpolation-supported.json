{
  "version": 8,
  "name": "Reduced MapLibre camera-expression example",
  "sources": {
    "points": {
      "type": "geojson",
      "data": "caller-owned points"
    }
  },
  "layers": [
    {
      "id": "points",
      "type": "circle",
      "source": "points",
      "paint": {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 5, 1, 10, 5],
        "circle-color": "#336699"
      }
    }
  ]
}
